<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone plugin: GC Suspend (suspends the managed GC to remove periodic stutter)

    Build:
      export DOTNET_ROOT="/path/to/dotnet"
      dotnet build -c Release -p:GameDir="/path/to/Koikatu"

    Output: bin/Release/GCSuspend.dll -> drop into BepInEx/plugins/

    Runtime dependency: BepInEx/plugins/monoPatcher.dll (bundled with CharaAnime).
    It is not referenced at compile time - the exports are resolved at runtime
    through LoadLibrary + GetProcAddress.
  -->
  <PropertyGroup>
    <!-- Change this to your own game folder, or pass -p:GameDir=... on the command line -->
    <GameDir Condition="'$(GameDir)' == ''">I:/Koikatu</GameDir>

    <TargetFramework>net35</TargetFramework>
    <AssemblyName>GCSuspend</AssemblyName>
    <RootNamespace>GCSuspend</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>https://github.com/HanYuanyi</Company>
    <Description>GC Suspend - suspends the Boehm GC to remove periodic collection stutter</Description>
    <AssemblyTitle>GCSuspend</AssemblyTitle>
    <Product>GC Suspend</Product>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin/**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\CharaStudio_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
