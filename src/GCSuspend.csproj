<Project Sdk="Microsoft.NET.Sdk">

  <!--
    独立插件：GC Suspend（挂起托管 GC，消除周期性 GC 停顿）
    编译：
      export DOTNET_ROOT="<工作区>/05_工具链/dotnet"
      dotnet build -c Release -p:GameDir="I:/Koikatu"
    产物：bin/Release/GCSuspend.dll → 丢到 BepInEx/plugins/

    依赖：运行时要 BepInEx/plugins/monoPatcher.dll（CharaAnime 自带），
          编译时不引用它 —— 运行时用 LoadLibrary + GetProcAddress 动态取函数。
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">I:/Koikatu</GameDir>

    <TargetFramework>net35</TargetFramework>
    <AssemblyName>GCSuspend</AssemblyName>
    <RootNamespace>GCSuspend</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>https://github.com/HanYuanyi</Company>
    <Description>GC Suspend - 挂起 Boehm GC 消除周期性停顿</Description>
    <AssemblyTitle>GCSuspend</AssemblyTitle>
    <Product>GC Suspend</Product>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin/**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
    <Compile Remove="源码_反编译恢复/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\CharaStudio_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
